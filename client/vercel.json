{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/driveshare/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://yaadrive-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://yaadrive-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
