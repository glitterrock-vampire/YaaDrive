# Copy to .env and adjust.
PORT=3000
DATABASE_URL=postgres://driveshare:driveshare@localhost:5432/driveshare
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin of the Angular app (CORS)
CLIENT_ORIGIN=http://localhost:4200

# Cloudflare R2 Worker proxy (required in production for persistent car photos)
R2_PROXY_URL=
R2_PROXY_TOKEN=

# Free Brevo transactional email setup (verify EMAIL_FROM in Brevo first).
APP_URL=http://localhost:4200
BREVO_API_KEY=
EMAIL_FROM=
