# Copy to .env and adjust.
PORT=3000
DATABASE_URL=postgres://driveshare:driveshare@localhost:5432/driveshare
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin of the Angular app (CORS)
CLIENT_ORIGIN=http://localhost:4200

# Cloudflare R2 (required in production for persistent car photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
